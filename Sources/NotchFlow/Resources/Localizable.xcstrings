    "1. Click Connect agents — writes ~/.cursor/hooks.json and enables Local API.": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "1. Kliknij „Połącz agentów” — zapisuje ~/.cursor/hooks.json i włącza Local API."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "1. Klicke auf „Agents verbinden“ – schreibt ~/.cursor/hooks.json und aktiviert die Local API."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "1. Fai clic su «Collega gli agenti»: scrive ~/.cursor/hooks.json e attiva la Local API."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "1. Haz clic en «Conectar agentes»: escribe ~/.cursor/hooks.json y activa la Local API."
          }
        }
      }
    },
    "2. Fully quit Cursor (Cmd+Q) and open it again.": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "2. Całkowicie zamknij Cursor (Cmd+Q) i otwórz ponownie."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "2. Beende Cursor vollständig (Cmd+Q) und öffne es erneut."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "2. Chiudi completamente Cursor (Cmd+Q) e riaprilo."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "2. Cierra Cursor por completo (Cmd+Q) y vuelve a abrirlo."
          }
        }
      }
    },
    "3. Start Agent Chat — live status appears in the notch and clears when the agent finishes.": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "3. Uruchom Agent Chat — status pojawia się w notchu i znika po zakończeniu pracy agenta."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "3. Starte Agent Chat – der Live-Status erscheint in der Notch und verschwindet, wenn der Agent fertig ist."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "3. Avvia Agent Chat: lo stato in tempo reale compare nel notch e scompare quando l’agente termina."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "3. Inicia Agent Chat: el estado en directo aparece en el notch y desaparece cuando el agente termina."
          }
        }
      }
    },
    "Claude Code: Allow / Deny in the notch. Cursor: keeps its own Skip/Run — the notch pulses on likely consent moments; tap to jump (no auto-focus).": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude Code: Allow / Deny w notchu. Cursor: własne Skip/Run — notch pulsuje przy prawdopodobnej zgodzie; kliknij, żeby skoczyć (bez auto-focusu)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude Code: Erlauben / Ablehnen in der Notch. Cursor: behält sein eigenes Skip/Run – die Notch pulsiert bei wahrscheinlichen Freigabemomenten; tippe, um hinzuspringen (kein Auto-Fokus)."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude Code: Consenti / Rifiuta nel notch. Cursor: mantiene i propri Skip/Run; il notch pulsa nei probabili momenti di consenso: tocca per saltare (senza auto-focus)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude Code: Permitir / Denegar en el notch. Cursor: mantiene sus propios Skip/Run; el notch pulsa en los probables momentos de consentimiento: pulsa para saltar (sin enfoque automático)."
          }
        }
      }
    },
    "Claude Code is wired automatically via ~/.claude/settings.json.": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude Code łączy się automatycznie przez ~/.claude/settings.json."
          }
        },
        "de": {
          "stringUnit": {
