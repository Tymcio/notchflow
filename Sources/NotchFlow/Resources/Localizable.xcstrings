    "On Macs and displays without a notch, the island sits in the middle of the menu bar. Hover there to open it.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On Macs and displays without a notch, the island sits in the middle of the menu bar. Hover there to open it."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Na Macach i ekranach bez notcha wyspa jest na środku paska menu. Najedź tam kursorem, aby ją otworzyć."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf Macs und Bildschirmen ohne Notch sitzt die Insel in der Mitte der Menüleiste. Bewege den Zeiger dorthin, um sie zu öffnen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sui Mac e sugli schermi senza notch, l'isola si trova al centro della barra dei menu. Passa lì il puntatore per aprirla."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En Mac y pantallas sin notch, la isla está en el centro de la barra de menús. Pasa el puntero por ahí para abrirla."
          }
        }
      }
    },
